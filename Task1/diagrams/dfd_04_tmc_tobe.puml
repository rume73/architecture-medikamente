@startuml dfd_04_tmc_tobe
title DFD To-Be. Процесс 4. Учёт ТМЦ и закупок (C4 Container)

top to bottom direction
!includeurl https://raw.githubusercontent.com/RicardoNiepel/C4-PlantUML/master/C4_Container.puml

Person(Warehouse, "Сотрудник склада", "Принимает поставки")
Person(Accountant, "Бухгалтер", "Ведёт учёт")
System_Ext(Supplier, "Поставщик", "Внешний контрагент")

System_Boundary(Medicamente, "Медикаменте") {
  Container(P4_1, "Приём поставки", "Сервис", "Приёмка [RBAC]")
  Container(P4_2, "Оприходование", "1С ТиС клиент-сервер", "Приход [AES]")
  Container(P4_3, "Передача в бухгалтерию", "API-интеграция", "Проводка [TLS]")
  ContainerDb(DS_1C_Trade, "1С:Торговля и склад", "Клиент-сервер + СУБД", "ТМЦ [AES][RBAC]")
  ContainerDb(DS_1C_Acc, "1С:Бухгалтерия", "Клиент-сервер + СУБД", "Проводки [AES][RBAC]")
}

System_Ext(AuditLog, "Аудит-лог", "Elastic", "Журналирование [AUDIT]")

Rel(Supplier, P4_1, "Накладная [commercial] [TLS]")
Rel(Warehouse, P4_1, "Приёмка [commercial] [RBAC]")
Rel(P4_1, P4_2, "Данные поставки [commercial]")
Rel(P4_2, DS_1C_Trade, "Приход [commercial] [AES][RBAC]")
Rel(DS_1C_Trade, P4_3, "Данные для учёта [commercial] [TLS]")
Rel(P4_3, DS_1C_Acc, "Проводка [commercial] [AES][RBAC]")
Rel(DS_1C_Acc, Accountant, "Отчёт [commercial] [RBAC][AUDIT]")
Rel(P4_3, AuditLog, "События учёта [AUDIT]")

note right of DS_1C_Trade
  1С переведена в клиент-сервер.
  Интеграция через API с TLS,
  а не через OLE.
end note
@enduml